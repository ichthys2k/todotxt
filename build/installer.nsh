!macro customInit
  nsExec::Exec 'taskkill /F /IM "Todo.txt.exe" /T'
!macroend

!macro customInstall
  nsExec::Exec 'taskkill /F /IM "Todo.txt.exe" /T'
!macroend

!macro customUnInit
  nsExec::Exec 'taskkill /F /IM "Todo.txt.exe" /T'
!macroend

!macro customUnInstall
  nsExec::Exec 'taskkill /F /IM "Todo.txt.exe" /T'
!macroend
